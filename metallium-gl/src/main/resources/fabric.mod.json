{
  "schemaVersion": 1,
  "id": "metallium-gl",
  "version": "${version}",
  "name": "Metallium GL",
  "description": "OpenGL to Metal translation layer: runs the raw OpenGL calls of opted-in mods on Metallium's Metal backend.",
  "authors": ["Crash09N – NPR Media"],
  "contact": {"homepage": "https://github.com/Crash09N/metallium", "sources": "https://github.com/Crash09N/metallium", "issues": "https://github.com/Crash09N/metallium/issues"},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["dev.metallium.gl.retarget.MetalliumGlPreLaunch"]
  },
  "mixins": ["metallium-gl.mixins.json"],
  "depends": {
    "metallium": "*",
    "minecraft": "~26.3"
  },
  "custom": {
    "modmenu": {
      "parent": "metallium"
    }
  }
}
