{
  "schemaVersion": 1,
  "id": "metallium-iris",
  "version": "${version}",
  "name": "Metallium Iris Adapter",
  "description": "Runs Iris shader packs on Metallium's Metal backend. Bundled inside Metallium; inactive unless Iris 1.11.6+ and Sodium are installed. Licensed LGPL-3.0; source in the metallium-iris directory of the Metallium repository.",
  "authors": ["Crash09N – NPR Media"],
  "contact": {"homepage": "https://github.com/Crash09N/metallium", "sources": "https://github.com/Crash09N/metallium", "issues": "https://github.com/Crash09N/metallium/issues"},
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.metallium.iris.MetalliumIris"]
  },
  "mixins": ["metallium-iris.mixins.json"],
  "depends": {
    "metallium": "*",
    "minecraft": "~26.3"
  },
  "suggests": {
    "iris": ">=1.11.6 <1.12",
    "sodium": ">=0.9.2 <0.10"
  },
  "custom": {
    "modmenu": {
      "parent": "metallium"
    }
  }
}
