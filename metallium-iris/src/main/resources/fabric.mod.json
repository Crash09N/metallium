{
  "schemaVersion": 1,
  "id": "metallium-iris",
  "version": "${version}",
  "name": "Metallium Iris Adapter",
  "description": "Runs Iris shader packs on Metallium's Metal backend.",
  "authors": ["Metallium contributors"],
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.metallium.iris.MetalliumIris"]
  },
  "mixins": ["metallium-iris.mixins.json"],
  "depends": {
    "metallium": "*",
    "iris": "1.11.6",
    "sodium": ">=0.9.2"
  }
}
