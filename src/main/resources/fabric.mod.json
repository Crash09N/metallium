{
  "schemaVersion": 1,
  "id": "nativium",
  "version": "${version}",
  "name": "Nativium",
  "description": "Metal rendering backend for Minecraft on Apple Silicon. Runs vanilla, Sodium and Fabric rendering mods on Metal.",
  "authors": ["Crash09N – NPR Media"],
  "contact": {"homepage": "https://github.com/Crash09N/metallium", "sources": "https://github.com/Crash09N/metallium", "issues": "https://github.com/Crash09N/metallium/issues"},
  "contributors": ["Based on Metallum by kokodio (MIT)"],
  "license": "MIT",
  "icon": "assets/nativium/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["de.nprmedia.nativium.Nativium"],
    "sodium:config_api_user": ["de.nprmedia.nativium.compat.sodium.NativiumSodiumConfig"]
  },
  "mixins": [
    "nativium.mixins.json",
    "nativium.distanthorizons.mixins.json",
    "nativium.sodium.mixins.json",
    "nativium.voxy.mixins.json",
    "nativium.physicsmod.mixins.json",
    "nativium.betterf3.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25"
  },
  "recommends": {
    "sodium": ">=0.9.2 <0.10"
  },
  "suggests": {
    "iris": ">=1.11.6 <1.12"
  },
  "conflicts": {
    "sodium": "<0.9.2",
    "iris": ["<1.11.6", ">=1.12"]
  },
  "breaks": {
    "metallium": "*",
    "metallum": "*",
    "mcopt-metal": "*",
    "metalrender": "*",
    "minecraft_metal": "*"
  }
}
