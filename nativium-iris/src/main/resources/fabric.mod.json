{
  "schemaVersion": 1,
  "id": "nativium-iris",
  "version": "${version}",
  "name": "Nativium Iris Adapter",
  "description": "Runs Iris shader packs on Nativium's Metal backend. Bundled inside Nativium; inactive unless Iris 1.11.6+ and Sodium are installed. Licensed LGPL-3.0; source in the nativium-iris directory of the Nativium repository.",
  "authors": ["Crash09N – NPR Media"],
  "contact": {"homepage": "https://github.com/Crash09N/metallium", "sources": "https://github.com/Crash09N/metallium", "issues": "https://github.com/Crash09N/metallium/issues"},
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["de.nprmedia.nativium.iris.NativiumIris"]
  },
  "mixins": ["nativium-iris.mixins.json"],
  "depends": {
    "nativium": "*",
    "minecraft": "~26.3"
  },
  "suggests": {
    "iris": ">=1.11.6 <1.12",
    "sodium": ">=0.9.2 <0.10"
  },
  "custom": {
    "modmenu": {
      "parent": "nativium"
    }
  }
}
